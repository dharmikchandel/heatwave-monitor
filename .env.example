# Copy to .env and adjust. Read by `make up` / docker compose (deploy/docker-compose.yml).
# Every value has a default; an empty .env works.

# ---- weather ----
# "openmeteo" = live data (default), "simulated" = scripted weather, no network needed.
WEATHER_SOURCE=openmeteo
# Simulated scenario: normal | building | extreme (can also be changed live through the admin API)
SIMULATED_SCENARIO=normal
# Fraction of simulated samples blanked, to exercise the data cleaning (0-1)
SIMULATED_NULL_RATE=0
# How often watched locations are refreshed
POLL_INTERVAL=15m

# ---- alerts ----
# Lowest risk level that opens an alert: caution | extreme-caution | danger | extreme-danger
OPEN_LEVEL=danger
# How long risk must stay below that level before an alert resolves
RESOLVE_AFTER=1h
# If heat returns within this long after resolution, the same alert reopens quietly
COOLDOWN=2h
# Log every alert in the alert service's log (handy with no subscribers)
DEFAULT_LOG_SUBSCRIPTION=true
# Comma-separated hostnames webhooks may target (empty = any). Set this in any shared deployment.
WEBHOOK_ALLOWED_HOSTS=

# ---- gateway ----
# Bearer token for admin endpoints (delete/refresh/simulation/subscriptions/acknowledge).
# Empty keeps them closed. Use a long random value, e.g.:  openssl rand -hex 24
ADMIN_TOKEN=
# Browser origins allowed to call the API cross-origin (comma-separated; empty = same-origin only)
CORS_ORIGINS=
# Take client addresses from X-Forwarded-For (only behind a proxy you control)
TRUST_PROXY=false
RATE_LIMIT_PER_MIN=240
WRITE_RATE_LIMIT_PER_MIN=10
WRITE_RATE_LIMIT_BURST=5

# ---- host ports (bound to localhost only; 8088 because Jenkins usually owns 8080) ----
FRONTEND_PORT=3000
GATEWAY_PORT=8088

# ---- images ----
TAG=dev

# Copy to .env and adjust. Used by deploy/docker-compose.yml (added in a later step).

# Weather source: "openmeteo" (live data) or "simulated" (scripted scenarios, no network)
WEATHER_SOURCE=openmeteo
# Simulated scenario: normal | building | extreme
SIMULATED_SCENARIO=building
# How often the weather service refreshes watched locations
POLL_INTERVAL=15m

# Host ports
FRONTEND_PORT=3000
GATEWAY_PORT=8080
